{
  "name": "cyber-launcher",
  "private": true,
  "version": "1.12.0",
  "description": "CyberLauncher — launcher de escritorio rápido y personalizable, por CyberGems",
  "type": "module",
  "author": "CyberGems <info@cybergems.org>",
  "license": "GPL-3.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:electron": "vite build && electron-builder",
    "build:win": "vite build && electron-builder --win",
    "build:portable": "vite build && electron-builder --win portable",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:cyberbot": "node --import tsx --test tests/cyberbot.test.ts",
    "test:cybermanager": "node --import tsx --test tests/cybermanager-recommendation.test.ts",
    "icons": "node scripts/generate-icons.mjs",
    "installer-graphics": "node scripts/generate-installer-graphics.mjs"
  },
  "build": {
    "appId": "com.cybergems.cyberlauncher",
    "productName": "CyberLauncher",
    "copyright": "© 2026 CyberGems",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron"
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/node-pty/prebuilds/**",
      "node_modules/node-pty/build/Release/**"
    ],
    "extraResources": [
      {
        "from": "electron/open-taskbar-settings.exe",
        "to": "open-taskbar-settings.exe"
      },
      {
        "from": "electron/check-fullscreen.exe",
        "to": "check-fullscreen.exe"
      }
    ],
    "win": {
      "icon": "public/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeader": "public/installerHeader.bmp",
      "installerSidebar": "public/installerSidebar.bmp",
      "uninstallerSidebar": "public/installerSidebar.bmp",
      "installerHeaderIcon": "public/icon.ico",
      "include": "electron/installer.nsh",
      "createDesktopShortcut": "always",
      "runAfterFinish": true,
      "installerLanguages": [
        "es",
        "en"
      ],
      "multiLanguageInstaller": true,
      "shortcutName": "CyberLauncher",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}",
      "unpackDirName": "CyberLauncher-portable",
      "requestExecutionLevel": "user"
    },
    "publish": {
      "provider": "github",
      "owner": "CyberGems",
      "repo": "CyberLauncher"
    }
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.546.0",
    "motion": "^12.38.0",
    "node-pty": "^1.1.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "42.11.10",
    "electron-builder": "^26.8.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
